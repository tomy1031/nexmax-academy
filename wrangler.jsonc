/**
 * Cloudflare Workers 設定（OpenNext 経由）。docs/design/09_Cloudflare移行実行計画.md を参照。
 *
 * - main / assets は `opennextjs-cloudflare build` の出力先。手で書き換えない。
 * - nodejs_compat は OpenNext の必須要件。
 * - compatibility_date は 2025-05-05 以降が必須（FinalizationRegistry 対策・計画書 §2.4）。
 *   OpenNext は「6か月より古い日付」に警告を出すので、更新時は現在に近い日付へ寄せる。
 * - incrementalCache は KV（kv_namespaces 参照）。学習者ページは `revalidate = 300` の
 *   ISR なので、キャッシュが無いと全アクセスがフルSSRになり CPU 上限を超える
 *   （2026-08-13 に Error 1102 が多発して導入。open-next.config.ts 参照）。
 *   R2 でなく KV なのはアカウントの R2 が未有効（課金設定が必要）なため。無料枠は
 *   KV 読み 10万/日・書き 1000/日。書きは再生成時のみ発生する。授業（20人同時）では
 *   見られたページ数×再生成回数で書きが積み上がるため、revalidate は 60→300 に延ばし、
 *   読みは拠点キャッシュ（withRegionalCache）で吸収する（2026-08-25・docs/deploy.md §0.7）。
 * - WORKER_SELF_REFERENCE は ISR の裏側の再生成（memoryQueue）が自分自身へ
 *   HEAD リクエストを送るための必須バインディング。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 公開URLは `<name>.<アカウントsubdomain>.workers.dev`。
  // name=academy・subdomain=nexmax で `academy.nexmax.workers.dev` になる。
  // 改名すると別 Worker になる（旧名のデプロイ履歴は引き継がれない）。
  "name": "academy",
  "main": ".open-next/worker.js",
  // Wrangler は OpenNext が作った handler を **もう一度 束ね直す**。ここを指定しないと
  // その 最終束ねだけ 圧縮されず、上げる大きさが gzip で 333KiB ふくらむ（実測）。
  // 無料枠の スクリプト上限は gzip 3MiB で、超えると deploy が code:10027 で 止まる。
  "minify": true,
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    {
      // 名前は OpenNext の KV incrementalCache が探す固定名。変えると効かなくなる。
      "binding": "NEXT_INC_CACHE_KV",
      // 2026-08-26 に `academy-next-inc-cache` から `-v2` へ引っ越した。
      // 前の置き場に **期限なしの作りおきが 14,334件・1 GB 前後**（無料枠ちょうど）
      // 溜まっていたため。中身は作り直せるキャッシュなので、空から始めてよい。
      // **鍵ごと**の削除は1日1000件までで14日かかるので、置き場ごと入れ替えた。
      // 旧 `academy-next-inc-cache` は 2026-08-27 に **namespace ごと削除**して片づけた
      // （管理操作なので鍵単位の書き込み枠とは別枠。1コマンドで 1.24 GB が消える）。
      // 以後は期限つきで置くので溜まらない（src/lib/cache/kv-expiring-cache.ts）。
      "id": "1ce53d77032747e0b8e52a0a44e1ebd6",
    },
  ],
  "services": [
    {
      // 名前は OpenNext の memoryQueue が探す固定名。変えると再生成が止まる。
      "binding": "WORKER_SELF_REFERENCE",
      "service": "academy",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
