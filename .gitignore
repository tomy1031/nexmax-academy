# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext
/.open-next/
.dev.vars
.wrangler/
cloudflare-env.d.ts

# 共有ファイル編集の一時承認マーカー（コミットしない）
.claude/allow-shared

# pdf.js の worker（npm install のたびに scripts/copy_pdf_worker.mjs が写す生成物）
/public/pdfjs/

# 通しの自動検証（Playwright）の出力。CI では成果物として上げる
/test-results/
/playwright-report/
/blob-report/
/e2e-screens/
/playwright/.cache/

# 絵の 作り直しの 作業場（PNG の 生の 出力・ログ）。置くのは webp だけ
/.tmp-img/
# 富田さんの 参考写真。**このリポジトリは public** なので 本人の 写真は 入れない
/富田.jpg
