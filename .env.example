# 環境変数の雛形。実値は .env.local にコピーして入れる（.env.local は commit しない）。
# NEXT_PUBLIC_ 接頭辞のものだけがブラウザに露出する。秘密鍵に接頭辞を付けないこと。

# ── Gemini（サーバ側プロキシ経由でのみ使用。クライアントに出さない） ──
# 設計方針03: フロントに APIキーを置く旧方式は廃止。呼び出しは API Route から行う。
GEMINI_API_KEY=

# ── Supabase（フェーズ1で導入予定） ──
# URL と anon key は公開可（RLSで保護）。service role key はサーバ専用の秘密。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
