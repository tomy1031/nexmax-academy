# 環境変数の雛形。実値は .env.local にコピーして入れる（.env.local は commit しない）。
# NEXT_PUBLIC_ 接頭辞のものだけがブラウザに露出する。秘密鍵に接頭辞を付けないこと。

# ── Gemini ──
# 単一の共有サーバーキーは持たない（BYOK方式）。生徒・教師が各自発行した
# 自分のAPIキーを設定画面から登録し、DBに保存する。ここに環境変数として置かない
# （設計方針03 §2）。

# ── Supabase（フェーズ1で導入予定） ──
# URL と anon key は公開可（RLSで保護）。service role key はサーバ専用の秘密。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
