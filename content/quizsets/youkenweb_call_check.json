{
  "kind": "quizset",
  "id": "youkenweb_call_check",
  "title": "聞きとりの かくにん：だれに 見て ほしい？",
  "description": "山本社長の Zoomの かくにんです。「どんな お客様に 見て ほしいか」と「社長と 先生の ちがい」を 整理します。",
  "nekumax": "listen",
  "phase": "research",
  "answerMode": "all",
  "passRate": 60,
  "requireAll": true,
  "questions": [
    {
      "id": "q_open",
      "type": "choose",
      "section": "1. えらぶ もんだい",
      "sectionNote": "Zoomの 話から えらびます。",
      "q": "Aobaの プノンペンの 店は、いつ オープンしますか。",
      "options": [
        "8月3日",
        "9月4日",
        "10月28日",
        "11月11日"
      ],
      "answer": 3,
      "explain": "正解は「11月11日」です。オープンの 前に、ウェブサイトが 要ります。",
      "points": 2
    },
    {
      "id": "q_kyaku",
      "type": "multi",
      "q": "山本社長が「見て ほしい」と 言った お客様を ぜんぶ えらんで ください。",
      "options": [
        "外国人の 観光客",
        "日本人の 駐在員の 家族",
        "カンボジアの 若い 人",
        "日本の 大学生"
      ],
      "answers": [
        0,
        1,
        2
      ],
      "explain": "正解は「観光客」「駐在員の 家族」「カンボジアの 若い 人」の 3つです。サイトを 見るのは、この 3つの お客様です。",
      "points": 2
    },
    {
      "id": "q_kyoushitsu",
      "type": "choose",
      "q": "佐々木先生が、茶道体験の ほかに 開きたい ものは 何ですか。",
      "options": [
        "抹茶の 工場",
        "茶道教室",
        "着物の 店",
        "日本語の 学校"
      ],
      "answer": 1,
      "explain": "正解は「茶道教室」です。毎月 通って、少しずつ 習う 教室です。",
      "points": 2
    },
    {
      "id": "q_shashin",
      "type": "choose",
      "section": "2. 二人の ちがい",
      "sectionNote": "社長と 先生の 気持ちを 考えます。",
      "q": "山本社長は、サイトに 何を たくさん のせたいと 言いましたか。",
      "options": [
        "写真",
        "地図",
        "値段",
        "動画"
      ],
      "answer": 0,
      "explain": "正解は「写真」です。若い 人に 来て ほしいので、SNSで 広げたいと 考えて います。",
      "points": 2
    },
    {
      "id": "q_chigai",
      "type": "choose",
      "q": "佐々木先生が「ちょっと……」と 言ったのは、何の ときですか。",
      "options": [
        "お点前の 間の 写真",
        "店の 値段",
        "Zoomの 時間",
        "茶道教室の 名前"
      ],
      "answer": 0,
      "explain": "正解は「お点前の 間の 写真」です。社長と 先生の 気持ちが 少し ちがいます。金曜日の Zoomで、先生に くわしく 聞いて みましょう。",
      "points": 2
    }
  ],
