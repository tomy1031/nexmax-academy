  "questions": [
    {
      "id": "shougai_q1",
      "type": "choose",
      "q": "問題は 何時ごろから 発生して いますか。",
      "options": [
        "午前8時ごろ",
        "午前10時ごろ",
        "午後10時ごろ"
      ],
      "answer": 1,
      "explain": "中村さんは「今日の 10時ごろから、一部の ユーザーが 予約できない 問題が 発生して います」と 言いました。"
    },
    {
      "id": "shougai_q2",
      "type": "choose",
      "q": "どのような 問題が 発生して いますか。",
      "options": [
        "一部の ユーザーが 予約できない",
        "商品画像が 表示されない",
        "ログインできない"
      ],
      "answer": 0,
      "explain": "「一部の ユーザーが 予約できない 問題が 発生して います」と 言いました。"
    },
    {
      "id": "shougai_q3",
      "type": "choose",
      "q": "どの ユーザーに 問題が 出て いますか。",
      "options": [
        "すべての ユーザー",
        "クレジットカードの ユーザー",
        "新しい ユーザー"
      ],
      "answer": 1,
      "explain": "「クレジットカードで 支払う ユーザーだけに 問題が 出て います」と 言いました。全員では ありません。"
    },
    {
      "id": "shougai_q4",
      "type": "choose",
      "q": "中村さんが 確認できて いる ことは 何ですか。",
      "options": [
        "APIで エラーが 出て いる",
        "原因が 完全に 分かった",
        "サーバーが 停止して いる"
      ],
      "answer": 0,
      "explain": "「APIで エラーが 出て いる ことは 確認しました。ただ、詳しい 原因は まだ 分かって いません」と 言いました。"
    },
    {
      "id": "shougai_q5",
      "type": "choose",
      "q": "中村さんは 今、何を 確認して いますか。",
      "options": [
        "GitHubの Issue",
        "エラーが 発生した 時間の ログ",
        "ユーザーの 名前"
      ],
      "answer": 1,
      "explain": "「今は、エラーが 発生した 時間の ログを 確認して います」と 言いました。"
    }
  ],
