      "id": "q_ses",
      "type": "choose",
      "q": "「SES」では、どこで 働きますか。",
      "options": [
        "お客様の 会社の オフィス",
        "自分の 会社の オフィス",
        "学校",
        "家"
      ],
      "answer": 0,
      "explain": "正解は「お客様の 会社の オフィス」です。SESは、お客様の 会社へ 行って、お客様の チームに 入って 働きます。",
      "points": 2
    },
    {
      "id": "q_jutaku",
      "type": "choose",
      "q": "「受託開発」では、どこで システムを 作りますか。",
      "options": [
        "お客様の 会社の オフィス",
        "自分の 会社の オフィス",
        "学校",
        "家"
      ],
      "answer": 1,
      "explain": "正解は「自分の 会社の オフィス」です。たのまれた ものを、自分の 会社で 作ります。SESとの 大きな ちがいは、働く 場所です。",
      "points": 2
    },
    {
      "id": "q_jisha",
      "type": "choose",
      "q": "「自社開発」では、何を 作りますか。",
      "options": [
        "お客様に たのまれた システム",
        "自分たちの サービスや アプリ",
        "お客様の 会社の 報告書",
        "学校の 教科書"
      ],
      "answer": 1,
      "explain": "正解は「自分たちの サービスや アプリ」です。たのまれた ものでは なく、自分の 会社の ものを 作ります。",
      "points": 2
    },
    {
      "id": "q_ii_ses",
      "type": "choose",
      "q": "「いろいろな 現場で、開発の 経験を 積める」。これは どの 案件の いい ところですか。",
      "options": [
        "SES",
        "受託開発",
        "自社開発"
      ],
      "answer": 0,
      "explain": "正解は SES です。行く 現場が 変わるので、新しい 技術や 進め方に 出会えます。",
      "points": 2
    },
    {
      "id": "q_ii_jutaku",
      "type": "choose",
      "q": "「仲間と 力を 合わせて、完成を 目指す」。これは どの 案件の いい ところですか。",
      "options": [
        "SES",
        "受託開発",
        "自社開発"
      ],
      "answer": 1,
      "explain": "正解は 受託開発 です。自分の 会社の 仲間と 作るので、完成した ときに 達成感が あります。",
      "points": 2
    },
    {
      "id": "q_ii_jisha",
      "type": "choose",
      "q": "「使う 人の 声を 聞いて、少しずつ よく できる」。これは どの 案件の いい ところですか。",
      "options": [
        "SES",
        "受託開発",
        "自社開発"
      ],
      "answer": 2,
      "explain": "正解は 自社開発 です。長い 時間を かけて、自分たちの サービスを 育てられます。",
      "points": 2
    },
    {
      "id": "q_zenbu",
      "type": "choose",
      "q": "ネクストメイクは、3つの 案件の うち どれを やって いますか。",
      "options": [
        "SESだけ",
        "受託開発だけ",
        "自社開発だけ",
        "3つ 全部"
      ],
      "answer": 3,
      "explain": "正解は「3つ 全部」です。だから、あなたが やりたい 案件を えらぶ ことが できます。どれに 興味が ありますか。",
      "points": 2
    }
