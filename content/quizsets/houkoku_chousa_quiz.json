  "id": "houkoku_chousa_quiz",
  "title": "技術調査の 報告の もんだい",
  "description": "聞いた 会話を 思い出して、正しい ものを 1つ えらびます。",
  "nekumax": "listen",
  "phase": "research",
  "answerMode": "submit",
  "passRate": 60,
  "questions": [
    {
      "id": "chousa_q1",
      "type": "choose",
      "q": "小林さんは 何に ついて 調査しましたか。",
      "options": [
        "商品画像を 保存する 方法",
        "商品を 検索する 方法",
        "CSVを アップロードする 方法"
      ],
      "answer": 0,
      "explain": "小林さんは「画像を 保存する 方法に ついて、調査が 終わりました」と 言いました。「商品画像が 増えても 管理しやすい」とも 言って います。"
    },
    {
      "id": "chousa_q2",
      "type": "choose",
      "q": "小林さんが 調べた 方法は いくつ ありますか。",
      "options": [
        "一つ",
        "二つ",
        "三つ"
      ],
      "answer": 1,
      "explain": "「二つの 方法を 調べました」と 言いました。"
    },
    {
      "id": "chousa_q3",
      "type": "choose",
      "q": "小林さんは、どちらの 方法が よいと 考えて いますか。",
      "options": [
        "今 使って いる サーバー",
        "AWSの S3",
        "パソコンに 保存する 方法"
      ],
      "answer": 1,
      "explain": "「今回は、S3を 使う 方が よいと 思います」と 言いました。"
    },
    {
      "id": "chousa_q4",
      "type": "choose",
      "q": "100GB 保存すると、料金は 月に だいたい いくらですか。",
      "options": [
        "36円",
        "360円",
        "3,600円"
      ],
      "answer": 1,
      "explain": "「100GB 保存すると、料金は 月に だいたい 360円です」と 言いました。"
    },
    {
      "id": "chousa_q5",
      "type": "choose",
      "q": "加藤さんは、小林さんに 最後に 何を するように 言いましたか。",
      "options": [
        "すぐに S3を 使い始める",
        "もう一度 料金を 調べる",
        "料金と 調査結果を GitHubの Issueに まとめる"
      ],
      "answer": 2,
      "explain": "加藤さんは「料金と 調査結果を GitHubの Issueに まとめて ください」と 言いました。"
    }
  ],
