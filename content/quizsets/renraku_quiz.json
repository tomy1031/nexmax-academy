      "id": "r_q4",
      "type": "choose",
      "q": "お願いは 全部で いくつ ありますか。",
      "options": [
        "2つ",
        "3つ",
        "4つ",
        "5つ"
      ],
      "answer": 1,
      "explain": "「お願いが 3つ あります」と 言ってから、1つずつ 番号を 付けて います。"
    },
    {
      "id": "r_q5",
      "type": "choose",
      "q": "もっと 良い 連絡に する には、何が 大切ですか。",
