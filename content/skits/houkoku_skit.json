{
  "kind": "skit",
  "id": "houkoku_skit",
  "title": "スキット：仕事が 終わった ときの 報告",
  "description": "テストが 終わった ことを、上司の 冨永さんに 報告します。",
  "focus": "「今、お時間 よろしいですか」から 始める ところに 注目して、まねして みましょう。",
  "cover": {
    "src": "/img/hourensou/houkoku/skit.webp",
    "refs": [],
    "status": "done"
  },
  "roles": [
    {
      "id": "pg",
      "name": "あなた",
      "role": "PG（プログラマー）",
      "accent": "leaf",
      "side": "right"
    },
    {
      "id": "pm",
      "name": "冨永さん",
      "role": "PM（上司）",
      "accent": "sky",
      "side": "left"
    }
  ],
  "lines": [
    {
      "speaker": "pg",
      "text": "冨永さん、お疲れさまです。今、お時間 よろしいですか。",
      "note": "いきなり 話を 始めないで、まず 許可を もらいます。",
      "audioUrl": "/audio/skits/houkoku_skit/l01.mp3"
    },
    {
      "speaker": "pm",
      "text": "はい、いいですよ。どう しましたか。",
      "audioUrl": "/audio/skits/houkoku_skit/l02.mp3"
    },
    {
      "speaker": "pg",
      "text": "ログイン機能の 件ですが、無事 テストが 終わりました。確認を お願いします。",
      "note": "「何の 件か」→「どう なったか」の 順に 言います。",
      "audioUrl": "/audio/skits/houkoku_skit/l03.mp3"
    },
    {
      "speaker": "pm",
      "text": "わかりました。後で 見て おきますね。ありがとう ございます。",
      "audioUrl": "/audio/skits/houkoku_skit/l04.mp3"
    },
    {
      "speaker": "pg",
      "text": "よろしく お願いします。失礼します。",
      "audioUrl": "/audio/skits/houkoku_skit/l05.mp3"
    }
  ],
